# Звіт покриття. Пишеться при кожному `npm test` (900 КБ HTML і JSON) — рівно
# те, що PROJECT-STRUCTURE-v8 § 1 називає артефактом, який не комітиться.
coverage/

# Логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Артефакти емулятора Firebase (npm run check:rules, npm run emulators).
# Пишуться в корінь при кожному прогоні — і це рівно те, що PROJECT-STRUCTURE-v8
# § 1 називає артефактом, який не комітиться.
*-debug.log
.firebase/
firebase-debug.*.log

# Системні файли
.DS_Store
Thumbs.db
desktop.ini

# Змінні оточення (Environment Variables)
.env
.env.local
.env.*
!.env.example
!.env.test

# Тимчасові файли Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Специфічні папки проєкту
.claude/
gitignore/
