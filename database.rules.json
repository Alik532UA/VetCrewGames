// Правила Realtime Database. Джерело правди — цей файл, а не консоль: правило,
// яке живе лише у вебінтерфейсі, неможливо ні звірити з кодом, ні побачити в
// історії змін (CLOUD-DATABASE-v8 § 2.1).
//
// ПЕРЕВІРЯЮТЬСЯ ГЕЙТОМ, А НЕ ОЧИМА: `npm run check:rules` піднімає емулятор і
// проганяє два набори випадків — «застосунок мусить це вміти» й «сторонній не
// мусить цього могти». Правила «дозволити все» валять другий набір, «заборонити
// все» — перший, тож зелений результат неможливий випадково
// (CLOUD-DATABASE-v8 § 3.1). Скрипт сам друкує, скільких випадків якого роду
// було, і сам падає, якщо один з наборів спорожнів. Гейт стоїть у CI.
//
// ВИКЛАДАННЯ. `firebase deploy --only database` — або руками через Firebase
// Console → Realtime Database → Rules. Поточний стан консолі супроти цього
// файлу записаний у PROJECT-CONTEXT.md; поки там стоїть «не звірений», вважати
// викладеним НЕ можна.
//
// ЩО ВОНО ЗАХИЩАЄ. Публічний конфіг Firebase за побудовою лежить у бандлі, тобто
// адресу бази знає кожен. Тому типова відповідь — заборона, а дозволи стоять
// рівно там, де застосунок справді пише, і кожен звужений до того, хто пише.
//
// ГОЛОВНЕ ПРАВИЛО — «лише створити» для ходів. Хід не можна ні перезаписати, ні
// підписати чужим імʼям. Саме це й дає порядок і одноразовість без сервера:
// повторний запис того самого номера відкидає база, а не клієнт.
//
// `$other: false` СТОЇТЬ НА КОЖНОМУ ВУЗЛІ З ВІДОМОЮ ФОРМОЮ, і це не косметика
// (CLOUD-DATABASE-v8 § 4.6). `.validate` перевіряє лише ті поля, які НАЗВАНІ:
// без цього рядка запис міг би принести десяте поле, якого схема не знає, а
// головне — розсинхрон імені поля між кодом і правилом лишався б тихим. У
// сусідньому `Slovko` правило валідувало серверний час у `last_changed`, код
// писав `lastChanged`, і захист не діяв НІ НА ЩО: справжнє поле проходило як
// невідоме. `$other: false` перетворює цей клас помилки з тихого на гучний —
// падає найближчий позитивний випадок гейта.
{
  "rules": {
    /*
     * ШТАМП ВЕРСІЇ — не дані, а УМОВА. Ставить `scripts/rules-stamp.mjs`.
     *
     * Дозвіл прочитати `/__rulesVersion/<штамп>` і є відповіддю «правила цієї
     * редакції викладені»; вузла за цим шляхом не існує й не потрібно, бо
     * правила оцінюються ДО існування. Інший штамп і спроба перелічити гілку
     * дають відмову — заміряно на емуляторі.
     *
     * Штамп — хеш СЕМАНТИКИ цього файлу (без коментарів і без самого блока), тож
     * правка коментаря не вимагає нового викладання, а зміна поведінки вимагає.
     * Руками не правити: `npm run rules:stamp`.
     */
    "__rulesVersion": {
      "$v": { ".read": "auth != null && $v === 'bd55b15936d0'" }
    },

    "rooms": {
      // Перелічити кімнати не можна: читання дозволене лише на конкретній
      // (нижче), а тут дозволу немає — отже, `GET /rooms` відкидається. Без
      // цього код кімнати перестав би бути її паролем: усі коди читалися б
      // одним запитом.
      "$code": {
        // Читають усі авторизовані: код кімнати й є її «пароль».
        ".read": "auth != null",

        // ЗНЕСТИ кімнату цілком може лише господар — і тільки знести:
        // `!newData.exists()` не дає під виглядом видалення переписати вміст.
        // Через це саме правило працює й `onDisconnect` господаря в лобі:
        // кімната, у яку ніхто не зайшов, зникає разом із його вкладкою. Через
        // нього ж працює прибирання СВОїх покинутих кімнат при створенні
        // наступної (`net/rtdbRoom.ts`): нових прав для збирача не додано
        // жодних, і саме тому він не є примітивом «видалити всі кімнати»
        // (CLOUD-DATABASE-v8 § 9.3).
        ".write": "auth != null && !newData.exists() && data.child('info/hostUid').val() === auth.uid",

        "info": {
          // Створити може будь-хто авторизований, але тільки назвавши господарем
          // СЕБЕ. Далі міняти — лише господареві: він починає партію.
          ".write": "auth != null && (data.exists() ? data.child('hostUid').val() === auth.uid : newData.child('hostUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['gameId', 'rulesVersion', 'seed', 'status', 'hostUid'])",
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'over')"
          },
          "gameId": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "hostUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "seed": { ".validate": "newData.isNumber()" },
          "rulesVersion": { ".validate": "newData.isNumber()" },
          // Коли кімнату створили — СЕРВЕРНИМ часом. Від цієї позначки рахує
          // вік покинутої кімнати збирач у `rtdbRoom.ts`, тож клієнтське число
          // тут означало б «моя кімната ніколи не застаріє».
          "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000" },
          // Коли партію почали. Від цієї позначки рахується перший хід, тож
          // ставить її сервер, а не клієнт — див. `at` у ходах.
          "startedAt": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000" },
          // Коли почався відлік до автоматичного старту. Так само СЕРВЕРНИЙ час:
          // від нього обидва учасники рахують ті самі секунди, а клієнтське число
          // дало б господареві право оголосити відлік уже скінченим.
          //
          // Скасування — це ВИДАЛЕННЯ поля, і `.validate` на видалення не діє, тож
          // окремого дозволу воно не потребує: право міняти `info` вже звужене до
          // господаря вище.
          // Режим початку партії. Булеве, і `$other: false` нижче вимагає, щоб
          // поле було НАЗВАНЕ тут: інакше запис із ним відкидався б цілком, і
          // виглядало б це як зламане лобі, а не як забуте правило.
          "autoStart": { ".validate": "newData.isBoolean()" },
          "countdownAt": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000" },
          // Налаштування партії: для конверта це непрозорий обʼєкт, і перелік
          // ключів у нього свій у кожної гри. Тому межа накладається на
          // ЗНАЧЕННЯ, а не на імена, і `$other` тут не ставиться — його роль
          // виконує сам `$key` (CLOUD-DATABASE-v8 § 4.6, останній пункт).
          "config": {
            "$key": { ".validate": "newData.isNumber()" }
          },
          "$other": { ".validate": false }
        },

        "members": {
          "$uid": {
            // Кожен пише лише про себе — і про себе ж може піти.
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.hasChildren(['name', 'role', 'order'])",
            "role": {
              ".validate": "newData.val() === 'player' || newData.val() === 'spectator'"
            },
            /*
             * ІМʼЯ — 48 СИМВОЛІВ, і це число має історію.
             *
             * Було 24, і воно різало НЕ введене руками, а власний список імен
             * проєкту: «прикметник + тварина» у німецькій дає складені слова
             * («Seltsames Schnabeltier» — 22), а повна назва картки з уточненням
             * («Wilder Manul (Pallaskatze)») — 26. Тобто межа бази диктувала, які
             * імена взагалі можна вигадати, і робила це молча: довше імʼя база
             * ВІДКИДАЄ, а на екрані це «не вдалося зайти в кімнату».
             *
             * 48, а не 32: тридцяти двох тим самим складеним словам замало вже з
             * трохи довшим прикметником. І не 64: імʼя показується рядком у таблі
             * й у переліку кімнат, де довге вже обрізається трьома точками, тож
             * зайві символи купують лише важчий запис.
             */
            "name": { ".validate": "newData.isString() && newData.val().length <= 48" },
            /*
             * КРАЇНА — рівно дві літери, і рівно стільки.
             *
             * Прапор гравця. Межа тут не про місце, а про те, що поле означає: код
             * ISO 3166-1 alpha-2 має два символи, і будь-що інше — або чужа рука,
             * або наш дефект. Клієнт це теж перевіряє (`config/countries.ts`), але
             * правило перевіряє те, що ЗАПИСАНО, а не те, що показано.
             *
             * Поле НЕОБОВʼЯЗКОВЕ: «без прапора» — законна відповідь, і виглядає
             * вона як відсутність поля, а не як порожній рядок. Тому в
             * `hasChildren` його немає.
             */
            "country": {
              ".validate": "newData.isString() && newData.val().length === 2"
            },
            /*
             * ПОРЯДОК ВХОДУ НЕЗМІННИЙ ПІСЛЯ ПЕРШОГО ЗАПИСУ.
             *
             * З цього числа рахується черга ходів (`controllers/pairsMatch`:
             * гравці сортуються за `order`). Доти правило перевіряло лише
             * `isNumber` — тобто учасник, уже впущений у кімнату, міг заявити
             * `order: 1` і забрати першу чергу в господаря. Не дірка в даних, а
             * зміна правил гри посеред партії.
             *
             * `!data.exists() || newData.val() === data.val()` дозволяє
             * ПОВТОРНИЙ вхід (сторінка після перезавантаження пише той самий
             * рядок складу з тим самим порядком — `joinRoom` бере його з
             * наявного) і забороняє зміну.
             *
             * Межа 12 — стеля складу на всі ігри проєкту. Вона тут не для
             * захисту від великого числа, а щоб `order` не міг стати 0 чи
             * відʼємним і опинитися перед господарем.
             *
             * ЩО ЦЕ НЕ ЗАКРИВАЄ: той, хто заходить УПЕРШЕ, все ще називає
             * порядок сам, і правило не має способу порахувати склад (у RTDB
             * немає примітива «скільки дітей»). Тому справжній розкол —
             * розходження двох пристроїв щодо того, чия черга, — знято в іншому
             * місці: сортування в адаптері має детермінований тайбрейк за
             * `uid`, тож однакові `order` дають однаковий порядок В УСІХ.
             */
            "order": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12 && (!data.exists() || newData.val() === data.val())"
            },
            "$other": { ".validate": false }
          }
        },

        "moves": {
          // Стерти журнал ЦІЛКОМ — це «нова партія в тій самій кімнаті», і теж
          // лише господар. Окремий хід у журналі при цьому лишається незмінним
          // назавжди: правило нижче дозволяє тільки створення.
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('info/hostUid').val() === auth.uid",
          "$seq": {
            // ЛИШЕ створити, і лише від себе. Дві властивості за один рядок:
            // журнал не переписати, і хід не підписати чужим uid.
            ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid",
            ".validate": "newData.hasChildren(['seq', 'by', 'type', 'at'])",
            "seq": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "type": { ".validate": "newData.isString() && newData.val().length <= 16" },
            /*
             * ЧАС ХОДУ СТАВИТЬ СЕРВЕР, І ЦЕ НЕ МЕТАДАНІ.
             *
             * На цій позначці стоїть єдине правило гри, яке залежить від часу, —
             * межа очікування. Дозволяє вона ДВА ходи, і обидва означають «діяти
             * замість того, хто стоїть»: `yield` (забрати чергу) і `end`
             * (завершити партію). Обидва законні лише тоді, коли попередній хід
             * старіший за межу.
             *
             * Якби `at` писав клієнт, він міг би оголосити чужий хід простроченим
             * коли завгодно — і забрати чергу або закінчити партію, у якій
             * програє.
             *
             * Вікно замість рівності. Документований ідіом — `newData.val() ===
             * now`, і він працює, бо `ServerValue.TIMESTAMP` розкривається до
             * валідації. Вікно на пʼять секунд робить те саме, але не ламається
             * від різниці в роздільності часу між емулятором і продакшном; а
             * підробка в межах пʼяти секунд нічого не дає, бо межа очікування
             * рахується десятками секунд.
             */
            "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000" },
            "payload": {
              // Числа й короткі рядки. Спершу тут були лише числа — і перша ж
              // гра, якій потрібне слово чи літера, вимагала б правити правила
              // в консолі разом із релізом. Межа довжини лишається: вона й
              // захищає від рядка на десять мегабайтів у своєму ж ході.
              //
              // `$other` тут немає навмисно: перелік полів ходу свій у кожної
              // гри, тож межа накладається на значення. Кількість полів правилом
              // не обмежена — у RTDB немає примітива «скільки дітей»; це
              // записаний борг із названою причиною, а не забуття
              // (CLOUD-DATABASE-v8 § 4.6).
              "$field": {
                ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 32)"
              }
            },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    /*
     * АКАУНТИ, ПРОФІЛІ Й ПІДПИСКИ.
     *
     * ## Навіщо це взагалі з'явилося
     *
     * Доти в гру входили ЛИШЕ анонімно, і `uid` жив рівно доки живе сховище
     * браузера. Через це «кімнати друзів» були неможливі в принципі: не було чим
     * ні підписатися, ні впізнати того самого гравця наступного дня, ні навіть
     * відрізнити його від себе на іншому пристрої.
     *
     * Анонімний вхід ЛИШАЄТЬСЯ типовим, і це не компроміс: кімнату треба вміти
     * створити з першого дотику, а людина, яку на вході питають пароль, до
     * кімнати не доходить. Акаунт ПРИВʼЯЗУЄТЬСЯ до наявного анонімного
     * (`linkWithCredential`), тож `uid` не міняється — а разом із ним не гинуть
     * ні кімнати в індексі, ні підписки.
     *
     * ## Форма даних
     *
     *   users/{uid}/profile              { name, handle, country?, at }
     *   users/{uid}/following/{target}   { at }
     *   users/{uid}/followers/{who}      { at }
     *   handles/{handle}                 uid
     *
     * ## Чому профіль ПУБЛІЧНИЙ, а решти під `users` немає
     *
     * Профіль читає кожен авторизований, бо саме його показують у списку кімнат
     * і в пошуку. Нічого приватного в ньому немає за побудовою: імʼя й прапор і
     * так видно в кімнаті.
     *
     * Прогресу, рахунку чи налаштувань тут НЕМА й не мусить бути. Вони живуть у
     * сховищі браузера, і переносити їх у базу означало б новий клас питань
     * (чиї дані, як довго, хто може стерти) заради того, що вже працює.
     *
     * ## Дзеркало `followers` — і чому воно не дублювання
     *
     * `following` відповідає «на кого підписаний я», `followers` — «хто підписаний
     * на мене». Це РІЗНІ питання, і обидва треба відповідати одним читанням: без
     * дзеркала друге вимагало б перебрати всіх користувачів. Шлях запису в кожне
     * один: у `following/{target}` пише лише власник, у `followers/{who}` — лише
     * сам `who`. Тобто це не дві копії одного факту, а дві половини, кожна зі
     * своїм автором (CLOUD-DATABASE-v8 § 5.2).
     *
     * ДРУЗІ — ВЗАЄМНА ПІДПИСКА, і саме тому дзеркало обовʼязкове: перевірити
     * взаємність можна лише подивившись з обох боків.
     */
    "users": {
      // Перелічити всіх користувачів не можна: дозволу на цьому вузлі немає, тож
      // `GET /users` відкидається. Пошук людей іде через `handles` нижче — і лише
      // обмеженим запитом.
      "$uid": {
        "profile": {
          // Читає кожен авторизований: профіль і існує, щоб його бачили.
          ".read": "auth != null",
          ".write": "auth != null && $uid === auth.uid",
          ".validate": "newData.hasChildren(['name', 'handle'])",
          // Ті самі межі, що в складі кімнати: це те саме імʼя того самого
          // гравця, і розійшовшись, два числа дали б профіль, який не влазить у
          // кімнату.
          "name": { ".validate": "newData.isString() && newData.val().length <= 48" },
          /*
           * ПСЕВДОНІМ — малі латинські літери, цифри й підкреслення.
           *
           * Вузько навмисно: за ним шукають людей, і пошук мусить бути
           * однозначним. Змішані алфавіти дають пари, що виглядають однаково й
           * не збігаються («о» кирилична проти латинської) — тобто людину
           * неможливо знайти, хоч вона й є.
           */
          "handle": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20 && newData.val().matches(/^[a-z0-9_]+$/)"
          },
          "country": { ".validate": "newData.isString() && newData.val().length === 2" },
          // Коли профіль створили — СЕРВЕРНИМ часом, як і решта позначок.
          "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000" },
          "$other": { ".validate": false }
        },

        /*
         * НА КОГО ПІДПИСАНИЙ власник. Пише лише він.
         *
         * Видалити може ще й той, на кого підписані: це «прибери мене зі своїх
         * підписок», і без цього дозволу відписати нав'язливого підписника було б
         * нічим. Та сама пара прав, що в сусідньому `Slovko`.
         */
        "following": {
          ".read": "auth != null",
          "$target": {
            ".write": "auth != null && ($uid === auth.uid || ($target === auth.uid && !newData.exists()))",
            ".validate": "newData.hasChildren(['at'])",
            "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000" },
            "$other": { ".validate": false }
          }
        },

        // ХТО ПІДПИСАНИЙ на власника. Дзеркально: запис створює сам підписник
        // (ключ — його `uid`), а видалити може і він, і власник.
        "followers": {
          ".read": "auth != null",
          "$who": {
            ".write": "auth != null && ($who === auth.uid || ($uid === auth.uid && !newData.exists()))",
            ".validate": "newData.hasChildren(['at'])",
            "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000" },
            "$other": { ".validate": false }
          }
        },

        // Решта під користувачем — заборонено. Прогрес і налаштування тут не
        // живуть навмисно (див. вище).
        "$other": { ".validate": false }
      }
    },

    /*
     * ПСЕВДОНІМИ: унікальність і пошук людей.
     *
     * ## Чому окрема гілка, а не поле профілю
     *
     * Унікальність. Поле в профілі не можна перевірити на зайнятість, не читаючи
     * усіх користувачів, — а перелічувати `users` заборонено. Ключ у власній
     * гілці робить це одним читанням, і саме база стереже «лише один власник»:
     * правило нижче дозволяє СТВОРИТИ запис лише тому, хто назвав своїм `uid`, і
     * лише поки запису немає.
     *
     * ## Пошук — ЛИШЕ обмеженим запитом
     *
     * Той самий засув, що на `lobby`: без нього один запит вивантажував би всі
     * псевдоніми разом із їхніми `uid`, тобто повний список користувачів гри.
     * Тому читання гілки вимагає `orderByKey` і межі, а `.indexOn` тут не
     * потрібен — ключ уже впорядкований.
     *
     * Читання ОДНОГО псевдоніма дозволене окремо: це перевірка «чи вільний» і
     * «хто це», і вона не відкриває нічого, чого не відкриває пошук.
     */
    "handles": {
      ".read": "auth != null && query.orderByKey && query.limitToFirst <= 20",
      "$handle": {
        ".read": "auth != null",
        /*
         * ЗАЙНЯТИ МОЖНА ЛИШЕ ВІЛЬНИЙ, і лише на себе; звільнити — лише свій.
         *
         * Перезапис зайнятого не дозволений НІКОМУ, включно з власником: інакше
         * «зміна псевдоніма» виглядала б як перезапис чужого, і правило мусило б
         * розрізняти ці випадки за даними, яких у нього немає. Зміна робиться
         * двома діями: звільнити старий, зайняти новий.
         */
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },

    /*
     * ІНДЕКС СВОЇХ КІМНАТ — рівно для того, щоб господар міг прибрати за собою.
     *
     * Задача, яку це вирішує: кімната, покинута в стані `playing` або `over`,
     * доти не прибиралася НІКИМ. `onDisconnect` знімає лише ту, у яку ніхто не
     * зайшов (лобі); партія, з якої всі просто закрили вкладку, лишалася
     * назавжди. Записано це було боргом із числом («~1 КБ»), і борг правильний,
     * але код кімнати з пʼяти літер — ресурс скінченний, і колізії дорожчають.
     *
     * ЧОМУ ІНДЕКС, А НЕ ЗАПИТ. Щоб знайти свої кімнати запитом, потрібно було б
     * читати `rooms` цілком (`orderByChild('info/hostUid')`) — тобто відкрити
     * перелік усіх кімнат, а це рівно те, що заборонено вище: код кімнати
     * перестав би бути її паролем. Індекс, який пише сам господар, дає ту саму
     * відповідь, не відкриваючи нічого.
     *
     * ЧОМУ ЦЕ НЕ ДІРКА З § 9.3. Прибирання чужого вимагало б права видаляти
     * чуже — і саме тому збирач тут прибирає ЛИШЕ СВОЄ: право «знести свою
     * кімнату» господар мав і до цієї гілки, нових прав не додано жодних. Тобто
     * примітива «видалити всі кімнати» з цього не виходить.
     *
     * ЧОМУ НЕ В ЛОБІ. § 9.3 забороняє прибирання в тому клієнті, який відкрив
     * список, — і причина не в місці, а в правах. Тут збирач кличеться при
     * СТВОРЕННІ наступної кімнати: це той момент, коли господар точно є, і його
     * власні кімнати точно час перевірити. Найнадійніший варіант (§ 9.3, пункт
     * 1) — заплановане завдання на боці провайдера; воно вимагає тарифу Blaze й
     * лишається записаним у PROJECT-CONTEXT.md.
     */
    "myRooms": {
      "$uid": {
        // Свій індекс читає лише власник. Перелічити чужі кімнати цим не можна.
        ".read": "auth != null && $uid === auth.uid",
        "$code": {
          ".write": "auth != null && $uid === auth.uid",
          ".validate": "newData.hasChildren(['at'])",
          "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000" },
          "$other": { ".validate": false }
        }
      }
    },

    /*
     * ПЕРЕЛІК ПУБЛІЧНИХ КІМНАТ — окрема гілка, і саме тому вона можлива.
     *
     * ЧОГО ЦЕ КОШТУЄ, ПРЯМИМ ТЕКСТОМ. Ключ тут — КОД КІМНАТИ, а гілка читається
     * списком. Отже запис у `lobby` ВІДДАЄ КОД усім авторизованим: для цієї
     * кімнати код перестає бути паролем. Це не побічний ефект, а весь сенс
     * публічної кімнати — у неї й мусить зайти незнайомець. Тому вибір лишається
     * за господарем і зроблений він явно: прапорець «закрита кімната» у формі
     * входу означає рівно «не писати сюди», і закрита кімната поводиться так, як
     * поводилися всі до появи цієї гілки.
     *
     * ЧОМУ НЕ ПЕРЕЛІК `rooms`. Щоб зібрати список із `rooms`, довелося б дозволити
     * читання гілки цілком — і код перестав би бути паролем ДЛЯ ВСІХ кімнат
     * одразу, включно з тими, чиї господарі про це не просили. Окрема гілка робить
     * розкриття вибірковим і оборотним: зняв запис — кімната знову лише за кодом.
     *
     * ЩО САМЕ ТУТ ЛЕЖИТЬ. Лише те, що й так побачить кожен, хто зайде: імʼя
     * господаря (воно вже в `members`) і скільки гравців. НЕМАЄ `seed` і `config`:
     * вони визначають роздачу, і читати їх, не заходячи, означало б бачити дошку
     * суперника.
     *
     * ВИДАЛЕННЯ НЕ ЗАЛЕЖИТЬ ВІД ІСНУВАННЯ КІМНАТИ, і це не дрібниця. Прибирає цей
     * запис `onDisconnect`, а поруч стоїть така сама домовленість про саму кімнату
     * (`net/presence.ts`, `holdRoom`). Порядок їхнього виконання сервером НЕ
     * визначений: якби право на видалення перевіряло `rooms/$code/info/hostUid`,
     * то у випадку «кімнату знято першою» видалення запису відхилялося б — і в
     * списку назавжди лишався б привид кімнати, якої немає. Тому право на
     * видалення дає САМ ЗАПИС (`data.child('hostUid')`), а право на створення —
     * кімната.
     */
    "lobby": {
      /*
       * Читають усі авторизовані, і саме СПИСКОМ — на відміну від `rooms`. Але
       * ЛИШЕ ОБМЕЖЕНИМ ЗАПИТОМ, і це та сама межа, що в `MindStep`:
       * `allow list: if request.query.limit <= 50`.
       *
       * Доти тут стояло просте `auth != null`, а стеля в 20 записів жила лише в
       * клієнті (`LOBBY_LIMIT` у `net/lobby.ts`) — тобто була ввічливим проханням,
       * а не межею: той самий SDK із консолі браузера читав гілку цілком. Поки
       * кімнат одиниці, це нічого не коштує; на тисячі — це вивантаження всієї
       * гілки одним запитом, і платить за нього не той, хто його зробив.
       *
       * `query.limitToLast` у НЕобмеженого читання дорівнює null, а `null <= 25`
       * хибне — саме тому ця умова робить обмеження ОБОВʼЯЗКОВИМ, а не дозволеним.
       *
       * 25, а не 20: клієнт просить на один більше за показане, щоб чесно сказати
       * «є ще», і кілька одиниць запасу лишають місце на зміну стелі без правки
       * правил. Точну кількість кімнат при цьому не знає ніхто — і не мусить:
       * «показано найновіші, є ще» відповідає на те саме питання.
       */
      ".read": "auth != null && query.orderByChild === 'at' && query.limitToLast <= 25",
      /*
       * Індекс ОБОВʼЯЗКОВИЙ, щойно зʼявився `orderByChild`. Без нього база віддає
       * гілку ЦІЛКОМ і сортує на клієнті, лишивши попередження в консолі, якого в
       * продакшні не читає ніхто (CLOUD-DATABASE-v8 § 7.4) — тобто межа вище
       * діяла б, а економія зникла б.
       */
      ".indexOn": "at",
      "$code": {
        /*
         * ВИДАЛЕННЯ ДОЗВОЛЯЄ АБО САМ ЗАПИС, АБО КІМНАТА — і друга половина цієї
         * умови зʼявилася після справжнього дефекту в продакшні.
         *
         * Було лише `data.child('hostUid')`, тобто «власника називає сам запис». Це
         * правильно для прибирання привида (кімнати вже немає, запис лишився), але
         * ламало СТВОРЕННЯ: `publishRoom` спершу реєструє `onDisconnect().remove()`,
         * а вже потім пише запис. У мить реєстрації запису ще НЕМА, тож `data` —
         * null, і умова не виконувалася ніколи. Firebase перевіряє права на
         * `onDisconnect` саме при реєстрації, тож клієнт отримував
         * `PERMISSION_DENIED: room not published` — заміряно в консолі браузера
         * 2026-08-23 на кімнаті 9HMVK.
         *
         * Тепер обидва випадки покриті й жоден не залежить від порядку:
         * при реєстрації власника називає КІМНАТА, при прибиранні привида —
         * САМ ЗАПИС. Ширшим це не робить нічого: створити запис може лише господар
         * кімнати, тож «мій запис» і «моя кімната» вказують на ту саму людину.
         *
         * ЧОМУ ГЕЙТ ЦЬОГО НЕ ЗЛОВИВ: він пише через REST, а REST не вміє
         * `onDisconnect`. Перевірявся `set`, але не реєстрація. Випадок, який
         * відтворює саму перевірку прав («видалити ще неіснуючий запис»), тепер
         * стоїть у `scripts/check-rules.mjs`.
         */
        ".write": "auth != null && (!newData.exists() ? (data.child('hostUid').val() === auth.uid || root.child('rooms').child($code).child('info/hostUid').val() === auth.uid) : (newData.child('hostUid').val() === auth.uid && root.child('rooms').child($code).child('info/hostUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['hostUid', 'hostName', 'gameId', 'rulesVersion', 'players', 'at'])",
        "hostUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
        // Та сама межа, що в `members/$uid/name`: імʼя тут те саме, і розходження
        // меж означало б, що в списку показується довше, ніж змогло зайти.
        // Та сама межа, що в `members/{uid}/name`, і з тієї самої причини: сюди
        // потрапляє те саме імʼя господаря. Розійшовшись, ці два числа дали б
        // кімнату, у яку можна зайти, але яку не можна оголосити.
        "hostName": { ".validate": "newData.isString() && newData.val().length <= 48" },
        // Прапор господаря в переліку кімнат. Та сама межа, що в складі, і з тієї
        // самої причини: це той самий код країни того самого гравця.
        "hostCountry": {
          ".validate": "newData.isString() && newData.val().length === 2"
        },
        "gameId": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "rulesVersion": { ".validate": "newData.isNumber()" },
        // Стеля складу на всі ігри проєкту — та сама 12, що в `order`.
        "players": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12" },
        // Серверний час: за ним список упорядковується й за ним видно застояле.
        // Клієнтське число означало б «моя кімната завжди найновіша».
        "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000" },
        "$other": { ".validate": false }
      }
    },

    "presence": {
      "$code": {
        ".read": "auth != null",
        "$uid": {
          // Присутність гасне сама: `onDisconnect` виконує сервер, коли клієнт
          // зник. Саме через цей механізм тут RTDB, а не Firestore
          // (CLOUD-DATABASE-v8 § 5.1).
          ".write": "auth != null && $uid === auth.uid",
          // Форма перевіряється так само, як усюди. Доти тут не було нічого:
          // свій вузол присутності можна було набити чим завгодно й будь-якого
          // розміру — власник лишався власником, а межі не було.
          ".validate": "newData.hasChildren(['at'])",
          "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
