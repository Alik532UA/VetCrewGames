{
	"name": "app",
	"private": true,
	"version": "0.6.297",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/generate-sitemap.mjs",
		"preview": "vite preview",
		"prepare": "node scripts/prepare.mjs",
		"bump": "node scripts/bump-version.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:build": "node scripts/check-build.mjs",
		"check:i18n": "npx tsx scripts/check-translations.ts",
		"rules:stamp": "node scripts/rules-stamp.mjs",
		"rules:stamp:check": "node scripts/rules-stamp.mjs --check",
		"check:rules:live": "node scripts/check-rules-live.mjs",
		"rules:deploy": "node scripts/firebase-cli.mjs deploy --only database --project vet-crew-games",
		"check:rules": "node scripts/firebase-cli.mjs emulators:exec --project demo-vet-crew-games --only database,auth \"node scripts/check-rules.mjs\"",
		"emulators": "node scripts/firebase-cli.mjs emulators:start --project demo-vet-crew-games --only database,auth",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^25.6.0",
		"@types/three": "^0.185.4",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.2.1",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.5.0",
		"husky": "^9.1.7",
		"jsdom": "^29.0.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.59.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.4"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.50.0",
		"@threlte/core": "^8.5.16",
		"firebase": "^12.17.1",
		"lucide-svelte": "^1.0.1",
		"three": "^0.185.1"
	}
}
